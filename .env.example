# ============================================================
# Variables de entorno de Apiarios Carrión (plantilla)
# ============================================================
# Copia este archivo como `.env` y rellena tus valores.
# `.env` está en .gitignore: nunca subas claves reales al repositorio.

# --- Asistente Apícola IA (Google Gemini) ---
# Clave de API de Gemini (https://aistudio.google.com/apikey).
# SIN el prefijo VITE_ a propósito: la usa SOLO el proxy del servidor (la
# función de Firebase y el proxy de desarrollo de Vite), nunca el navegador.
# En producción se configura como secreto de Firebase:
#   firebase functions:secrets:set GEMINI_API_KEY
GEMINI_API_KEY=tu_key_aqui

# --- Firebase ---
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# --- Cloudinary (subidas de imágenes) ---
VITE_CLOUDINARY_CLOUD_NAME=
VITE_CLOUDINARY_UPLOAD_PRESET=
VITE_CLOUDINARY_PRODUCTS_UPLOAD_PRESET=

# --- Contacto de la tienda ---
VITE_CONTACT_EMAIL=
VITE_LEGAL_CONTACT_EMAIL=
VITE_WHATSAPP_NUMBER=
VITE_WHATSAPP_LABEL=

# --- Roles ---
VITE_OWNER_EMAILS=
VITE_ADMIN_EMAILS=
