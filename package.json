{
  "name": "sandbox-workspace",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "typecheck": "tsc --noEmit",
    "test:rules": "firebase emulators:exec --only firestore,storage --project demo-apiar-reglas \"node --test tests/rules/*.test.mjs\"",
    "test:scroll": "node --test tests/scrollLock.test.mjs",
    "test:motion": "node --test tests/motionSection.test.mjs",
    "bootstrap:admins": "node scripts/bootstrap-admins.mjs",
    "migrate:products": "node scripts/migrate-products-to-firestore.mjs",
    "prebuild": "node scripts/expand-app.mjs",
    "predev": "node scripts/expand-app.mjs",
    "postinstall": "node scripts/expand-app.mjs || true"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.1.0",
    "@dnd-kit/sortable": "^8.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@supabase/supabase-js": "^2.116.0",
    "@types/leaflet": "^1.9.22",
    "canvas-confetti": "^1.9.3",
    "date-fns": "^2.30.0",
    "firebase": "^12.19.0",
    "framer-motion": "^11.16.1",
    "jspdf": "^4.2.1",
    "leaflet": "^1.9.4",
    "lucide-react": "^0.294.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-leaflet": "^4.2.1",
    "react-router-dom": "^6.30.6",
    "recharts": "^2.15.4",
    "uuid": "^9.0.1",
    "vite-plugin-pwa": "^1.3.0"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^5.0.2",
    "@tailwindcss/vite": "^4.1.7",
    "@types/canvas-confetti": "^1.6.4",
    "@types/react": "^18.2.0",
    "@types/react-dom": "^18.2.0",
    "@types/uuid": "^9.0.7",
    "@vitejs/plugin-react": "^4.3.4",
    "firebase-admin": "^14.5.0",
    "jsdom": "^30.1.2",
    "playwright": "^1.64.0",
    "tailwindcss": "^4.1.7",
    "typescript": "^5.7.0",
    "vite": "^6.3.5"
  }
}
